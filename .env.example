# Copy to .env (which is gitignored) and fill in your keys. The demo server reads
# these; the keys stay SERVER-SIDE and are never sent to the browser.

# Required — the Storyteller + Guardian agents.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables REAL ink-and-watercolor art via Google Gemini image generation
# (gemini-2.5-flash-image). Without it, the demo falls back to placeholder art.
GEMINI_API_KEY=

# Optional: override the models.
# ABRA_MODEL=claude-opus-5
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: override the demo port (default 8787).
# PORT=8787
